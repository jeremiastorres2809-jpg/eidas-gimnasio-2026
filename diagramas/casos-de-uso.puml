@startuml casos-de-uso
title Diagrama de Casos de Uso - Sistema de Gestión de Gimnasio

left to right direction

actor Administrativo as A1
actor Entrenador as A2
actor Cliente as A3


rectangle "Sistema de Gestión de Gimnasio" {

  usecase "Buscar socio" as UC7
  usecase "Registrar socio" as UC1
  usecase "Registrar pago" as UC2
  usecase "Registrar asistencia" as UC3
  usecase "Asignar rutina" as UC4
  usecase "Ver rutina" as UC5
  usecase "Ver horarios" as UC6

}

A1 --> UC1
A1 --> UC2
A1 --> UC3

A2 --> UC4

A3 --> UC5
A3 --> UC6

UC2 ..> UC7 : <<include>>
UC3 ..> UC7 : <<include>>
UC4 ..> UC7 : <<include>>

@enduml
