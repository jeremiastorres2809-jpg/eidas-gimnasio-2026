@startuml
title Modelo Entidad-Relación - Sistema de Gestión de Gimnasio

hide circle

' --- Entidades ---
entity USUARIO {
  * id_usuario : integer <<PK>>
  --
  nombre : varchar
  apellido : varchar
  email : varchar
  telefono : varchar
  tipo_usuario : varchar
}

entity SOCIO {
  * id_usuario : integer <<PK>> <<FK>>
  --
  fecha_nacimiento : date
  estado_fisico : varchar
  objetivo : varchar
}

entity ENTRENADOR {
  * id_usuario : integer <<PK>> <<FK>>
  --
  especialidad : varchar
  fecha_ingreso : date
}

entity PAGO {
  * id_pago : integer <<PK>>
  --
  monto : decimal
  fecha : date
  id_socio : integer <<FK>>
}

entity RUTINA {
  * id_rutina : integer <<PK>>
  --
  descripcion : varchar
  fecha_asignacion : date
  id_socio : integer <<FK>>
  id_entrenador : integer <<FK>>
}

entity EJERCICIO {
  * id_ejercicio : integer <<PK>>
  --
  nombre : varchar
  descripcion : varchar
  series : integer
  repeticiones : integer
  id_rutina : integer <<FK>>
}

entity CLASE {
  * id_clase : integer <<PK>>
  --
  nombre : varchar
  descripcion : varchar
  horario : datetime
  duracion : integer
  id_entrenador : integer <<FK>>
}

entity ASISTENCIA {
  * id_asistencia : integer <<PK>>
  --
  fecha_hora : datetime
  id_socio : integer <<FK>>
  id_clase : integer <<FK>>
}

' --- Relaciones ---
' Sintaxis: EntidadA [cardinalidad] -- [cardinalidad] EntidadB : "etiqueta"
USUARIO ||--o| SOCIO : "es tipo de"
USUARIO ||--o| ENTRENADOR : "es tipo de"
SOCIO ||--o{ PAGO : "realiza"
SOCIO ||--o{ RUTINA : "tiene"
ENTRENADOR ||--o{ RUTINA : "asigna"
RUTINA ||--o{ EJERCICIO : "contiene"
ENTRENADOR ||--o{ CLASE : "dicta"
SOCIO ||--o{ ASISTENCIA : "registra"
CLASE |o--o{ ASISTENCIA : "recibe"

@enduml
